RewriteEngine On

# Prevent stale HTML caching on LiteSpeed / Browser after auto-deploy
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# Do not rewrite php-api requests
RewriteRule ^php-api/ - [L]

# Redirect legacy printed QR code URL (/student or /student/) to Verify Certificate page
RewriteRule ^student/?$ /verify-certificate/ [R=301,L,QSA]

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URL support for Next.js static export (trailingSlash: true)
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ %{REQUEST_URI}/index.html [L]

# Fallback for dynamic course slugs -> static detail page
RewriteRule ^courses/([^/]+)/?$ /courses/detail/index.html?slug=$1 [L,QSA]
